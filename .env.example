# Leave HM_CLIENT_ID empty to run in demo mode with a simulated Mind (no cognition spent).
HM_CLIENT_ID=
# Public URL of this app. Minds POST their jobs to $APP_URL/api/ingest, so in live mode
# it must be reachable from the internet (use a tunnel such as ngrok for local testing).
APP_URL=http://localhost:3000
# Archetype for new Minds (see POST /v1/minds/awaken).
HM_ARCHETYPE=research
# Where the "Top up" button sends users.
HM_TOPUP_URL=https://hellominds.ai
# Local SQLite by default; use libsql://… plus DATABASE_AUTH_TOKEN for Turso in production.
DATABASE_URL=file:./data/unemploy.db
DATABASE_AUTH_TOKEN=
