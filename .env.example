# Leave HM_CLIENT_ID empty to run in demo mode with a simulated Mind (no cognition spent).
HM_CLIENT_ID=
# Live mode only. 32 random bytes, base64: `openssl rand -base64 32`. Encrypts OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=
# Protects the daily watchdog cron (/api/cron/watchdog). Any long random string.
CRON_SECRET=
# URL of this app. Also the OAuth redirect base, so it must match a redirect URI on the
# Hello Minds client (http://localhost:3000 locally).
APP_URL=http://localhost:3000
# Where Minds POST their jobs ($INGEST_URL/api/ingest). Minds can't reach localhost, so
# for local live testing set this to a tunnel (`npm run tunnel`). Defaults to APP_URL.
INGEST_URL=
# Archetype for new Minds (see POST /v1/minds/awaken).
HM_ARCHETYPE=research
# Where the "Top up" button sends users.
HM_TOPUP_URL=https://hellominds.ai
# Supabase Postgres. On Vercel use the pooler's transaction-mode URI (port 6543).
# Leave empty locally to use an embedded Postgres in ./data (demo only).
DATABASE_URL=
# "waitlist" (default) shows the waitlist and closes sign-in; "open" lets anyone sign in.
LAUNCH_MODE=waitlist
# Before launch, sign in via /auth/login?access=<this code>.
EARLY_ACCESS_CODE=
# Verification emails (Resend). EMAIL_FROM must use a domain verified in Resend,
# e.g. "Unemploy <hello@yourdomain.com>". Without these, production keeps the simple email-only waitlist.
RESEND_API_KEY=
EMAIL_FROM=
